# `local` uses the app's scrypt password hashing; `neon` is mandatory in production.
AUTH_PROVIDER=local

# Stable server-only secret used to HMAC login rate-limit identifiers (minimum 32 bytes).
# Generate with: openssl rand -base64 32
LOGIN_RATE_LIMIT_HMAC_SECRET=
# Non-Vercel only: enable solely when the front proxy overwrites X-Forwarded-For
# with one validated client IP. Leave disabled for direct/local Next.js access.
LOGIN_RATE_LIMIT_TRUST_PROXY=0

# Neon Auth (staging/preview)
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Optional; Vercel uses VERCEL_URL automatically when this is empty.
NEXT_PUBLIC_APP_URL=http://localhost:3009
