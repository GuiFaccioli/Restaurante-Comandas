generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Mesa {
  id      String   @id
  numero  Int      @unique
  ativa   Boolean  @default(true)
  pedidos Pedido[]

  @@map("mesa")
}

model Categoria {
  id       String    @id
  nome     String
  ordem    Int       @default(0)
  produtos Produto[]

  @@map("categoria")
}

model Produto {
  id          String       @id
  categoriaId String       @map("categoria_id")
  nome        String
  descricao   String?
  preco       String
  disponivel  Boolean      @default(true)
  imagemUrl   String?      @map("imagem_url")
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  itensPedido ItemPedido[]

  @@map("produto")
}

model Pedido {
  id           String       @id
  mesaId       String       @map("mesa_id")
  status       String       @default("novo")
  criadoEm     Int          @map("criado_em")
  atualizadoEm Int          @map("atualizado_em")
  mesa         Mesa         @relation(fields: [mesaId], references: [id])
  itens        ItemPedido[]

  @@map("pedido")
}

model ItemPedido {
  id            String  @id
  pedidoId      String  @map("pedido_id")
  produtoId     String  @map("produto_id")
  quantidade    Int
  precoUnitario String  @map("preco_unitario")
  observacao    String?
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto @relation(fields: [produtoId], references: [id])

  @@map("item_pedido")
}

model Usuario {
  id           String          @id
  nome         String
  email        String          @unique
  role         String          @default("garcom")
  passwordHash String?         @map("password_hash")
  createdAt    Int             @map("created_at")
  updatedAt    Int             @map("updated_at")
  acessos      UsuarioAcesso[]
  sessions     AuthSession[]

  @@map("usuario")
}

model UsuarioAcesso {
  id        String  @id
  usuarioId String  @map("usuario_id")
  acesso    String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("usuario_acesso")
}

model AuthSession {
  id        String  @id
  usuarioId String  @map("usuario_id")
  tokenHash String  @unique @map("token_hash")
  expiresAt Int     @map("expires_at")
  createdAt Int     @map("created_at")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

